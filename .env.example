# Multi-Context RAG Chatbot Environment Variables

# Node & App
NODE_ENV=development
PORT=3000

# LLM Providers (Configure one or more)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Vector Store / Storage (e.g., ChromaDB, Pinecone, Qdrant, or PGVector)
VECTOR_STORE_PROVIDER=memory
VECTOR_STORE_API_KEY=
VECTOR_STORE_URL=

# RAG Configuration
RAG_DEFAULT_TOP_K=4
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
