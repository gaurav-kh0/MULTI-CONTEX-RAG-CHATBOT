# ==============================================================================
# Multi-Context RAG Chatbot Environment Variables
# ==============================================================================
# SECURITY NOTICE:
# Strictly server-only. Never expose API keys to the browser bundle.
# Do NOT prefix provider secrets with NEXT_PUBLIC_.
# ==============================================================================

# Node & App Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Central Chat Orchestration & History Windowing
# ------------------------------------------------------------------------------
# Selected provider if none is specified by client: 'gemini' | 'openrouter' | 'nvidia' | 'mock'
DEFAULT_LLM_PROVIDER=gemini
# Maximum recent conversational message turns passed to LLM generation (bounds context)
MAX_HISTORY_MESSAGES=10

# ------------------------------------------------------------------------------
# 1. Google Gemini Provider Adapter (Official @google/genai SDK)
# ------------------------------------------------------------------------------
# Required for Gemini generation:
GEMINI_API_KEY=
# Optional model override (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. OpenRouter Provider Adapter (Native Fetch OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
# Required for OpenRouter generation:
OPENROUTER_API_KEY=
# Optional model override (Default: meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Optional API base URL override (Default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 3. NVIDIA NIM Provider Adapter (Native Fetch OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
# Required for NVIDIA NIM generation:
NVIDIA_API_KEY=
# Optional model override (Default: meta/llama-3.3-70b-instruct)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Optional API base URL override (Default: https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# 4. RAG Text Embedding Configuration (Google Gemini text-embedding-004)
# ------------------------------------------------------------------------------
# Shares GEMINI_API_KEY from section 1 (or optional override EMBEDDING_API_KEY):
# EMBEDDING_API_KEY=
# Documented Gemini embedding model: text-embedding-004 (768 dimensions)
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# ------------------------------------------------------------------------------
# 5. Pinecone Vector Database Configuration (@pinecone-database/pinecone)
# ------------------------------------------------------------------------------
# Set VECTOR_STORE_PROVIDER to 'pinecone' to enable Pinecone (default: 'memory'):
VECTOR_STORE_PROVIDER=memory
# Required when VECTOR_STORE_PROVIDER=pinecone:
PINECONE_API_KEY=
# Pinecone index name (configured with dimension 768, metric cosine):
PINECONE_INDEX_NAME=multi-context-rag
# Optional dimension override (Default: 768 matching text-embedding-004):
PINECONE_DIMENSION=768
# Optional namespace within the index:
PINECONE_NAMESPACE=

# RAG Retrieval defaults:
RAG_DEFAULT_TOP_K=4
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

